@model MVCStudentRepository.Student

@{
    ViewBag.Title = "Delete";
}
<head>
    <link rel="stylesheet" href="~/Styles/buttons.css" />
    <script>
        function confirmDelete() {
            return confirm('Are you sure you want to delete this record?');
        }
    </script>
</head>
<div>
    <h4>Delete Student Record</h4>
    <hr />

    <dl class="dl-horizontal">
        <div class="row">
            <div class="col-md-3">
                <dt>@Html.DisplayNameFor(model => model.BNumber)</dt>
                <dd>@Html.DisplayFor(model => model.BNumber)</dd>
            </div>
            <div class="col-md-3">
                <dt>@Html.DisplayNameFor(model => model.FirstName)</dt>
                <dd>@Html.DisplayFor(model => model.FirstName)</dd>
            </div>
            <div class="col-md-3">
                <dt>@Html.DisplayNameFor(model => model.Surname)</dt>
                <dd>@Html.DisplayFor(model => model.Surname)</dd>
            </div>
            <div class="col-md-3">
                <dt>@Html.DisplayNameFor(model => model.Age)</dt>
                <dd>@Html.DisplayFor(model => model.Age)</dd>
            </div>
        </div>
    </dl>

    <hr />

    <dl class="dl-horizontal">
        <dt>Address</dt>
        <dd>
            @Html.DisplayFor(model => model.AddressLine1),
            @Html.DisplayFor(model => model.AddressLine2),
            @Html.DisplayFor(model => model.CityTown),
            @Html.DisplayFor(model => model.Postcode)
        </dd>
    </dl>

    <hr />

    <dl class="dl-horizontal">
        <div class="row">
            <div class="col-md-4">
                <dt>@Html.DisplayNameFor(model => model.Assessment1Mark)</dt>
                <dd>@Html.DisplayFor(model => model.Assessment1Mark)</dd>
            </div>
            <div class="col-md-4">
                <dt>@Html.DisplayNameFor(model => model.Assessment2Mark)</dt>
                <dd>@Html.DisplayFor(model => model.Assessment2Mark)</dd>
            </div>
            <div class="col-md-4">
                <dt>@Html.DisplayNameFor(model => model.OverallMark)</dt>
                <dd>@Html.DisplayFor(model => model.OverallMark)</dd>
            </div>
        </div>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="Buttons Delete" onclick="return confirmDelete();" /> |
            <a href="@Url.Action("Index")" class="Buttons Back">Back to List</a>
        </div>
    }
</div>
