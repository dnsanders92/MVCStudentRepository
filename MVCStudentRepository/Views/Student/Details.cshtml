@model MVCStudentRepository.Student

@{
    ViewBag.Title = "Details";
}
<head>
    <link rel="stylesheet" href="~/Styles/buttons.css" />
</head>
<h2>Details</h2>

<table class="table">
    <tr>
        <th>BNumber</th>
        <th>Surname</th>
        <th>First Name</th>
        <th>Age</th>
    </tr>
    <tr>
        <td>@Html.DisplayFor(model => model.BNumber)</td>
        <td>@Html.DisplayFor(model => model.Surname)</td>
        <td>@Html.DisplayFor(model => model.FirstName)</td>
        <td>@Html.DisplayFor(model => model.Age)</td>
    </tr>

    <tr>
        <th>Address Line 1</th>
        <th>Address Line 2</th>
        <th>City/Town</th>
        <th>Postcode</th>
    </tr>
    <tr>
        <td>@Html.DisplayFor(model => model.AddressLine1)</td>
        <td>@Html.DisplayFor(model => model.AddressLine2)</td>
        <td>@Html.DisplayFor(model => model.CityTown)</td>
        <td>@Html.DisplayFor(model => model.Postcode)</td>
    </tr>

    <tr>
        <th>Telephone</th>
        <th>Email</th>
        <th>Assessment 1</th>
        <th>Assessment 2</th>
        <th>Overall Mark</th>
    </tr>
    <tr>
        <td>@Html.DisplayFor(model => model.Telephone)</td>
        <td>@Html.DisplayFor(model => model.Email)</td>
        <td>@Html.DisplayFor(model => model.Assessment1Mark)</td>
        <td>@Html.DisplayFor(model => model.Assessment2Mark)</td>
        <td>@Html.DisplayFor(model => model.OverallMark)</td>
    </tr>
</table>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.BNumber }, new { @class = "Buttons Edit" })
    <a href="@Url.Action("Index")" class="Buttons Back">Back to List</a>
</p>
