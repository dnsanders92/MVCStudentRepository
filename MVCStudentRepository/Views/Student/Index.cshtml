@model IEnumerable<MVCStudentRepository.Student>

@{
    ViewBag.Title = "Index";
}
<head>
    <link rel="stylesheet" href="~/Styles/buttons.css" />
</head>
<style>
    .table td, .table th {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

<div style="display: flex; align-items: center;">
    <span style="margin-right: 5em;">
        <h2>Student Records</h2>
    </span>
    <span>
        <p>
            @Html.ActionLink("Create New Record", "Create", null, new { @class = "Buttons Edit", style = "white-space: nowrap;" })
        </p>
    </span>
</div>




<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Surname)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FirstName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Telephone)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Assessment1Mark)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Assessment2Mark)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.OverallMark)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Surname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telephone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Assessment1Mark)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Assessment2Mark)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OverallMark)
            </td>
            <td>
                <div class="button-container">
                    @Html.ActionLink("Edit", "Edit", new { id = item.BNumber }, new { @class = "Buttons Edit" })
                    @Html.ActionLink("Details", "Details", new { id = item.BNumber }, new { @class = "Buttons Details" })
                    @Html.ActionLink("Delete", "Delete", new { id = item.BNumber }, new { @class = "Buttons Delete" })
                </div>
            </td>

        </tr>
    }

</table>
